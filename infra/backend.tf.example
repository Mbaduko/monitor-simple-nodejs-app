# Copy to backend.tf and replace the mock values with the outputs of infra/remoteback
terraform {
  backend "s3" {
    region       = "eu-west-1"
    bucket       = "my-project-dev-123456789012-state"
    key          = "terraform.tfstate"
    use_lockfile = true
    encrypt      = true
    kms_key_id   = "arn:aws:kms:eu-west-1:123456789012:key/00000000-0000-0000-0000-000000000000"
  }
}
